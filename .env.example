# Database
DATABASE_URL='postgresql://user:password@host:port/database?schema=public'

# Next Auth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# AWS Storage (optional)
AWS_PROFILE="hosted_storage"
AWS_REGION="us-west-2"
AWS_BUCKET_NAME="your-bucket-name"
AWS_FOLDER_PREFIX="your-folder/"
ABACUSAI_API_KEY="your-abacus-api-key"

# Upstash Redis (optional — rate limiting da API pública /api/v1 e do chat widget)
# Sem estas variáveis, a API pública funciona normalmente, só sem rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Upstash QStash (obrigatório para lembretes e confirmações de presença por WhatsApp)
# QSTASH_TOKEN é usado pelo servidor para PUBLICAR jobs na fila (scripts/setup-qstash-schedules.ts
# e as rotas de cron). QSTASH_CURRENT_SIGNING_KEY/QSTASH_NEXT_SIGNING_KEY são usadas para
# VERIFICAR que uma requisição recebida veio de verdade do QStash — sem elas configuradas,
# as rotas internas assinadas (schedule-reminders, send-confirmations, dispatch-whatsapp)
# rejeitam toda requisição (fail closed). Pegue os três valores em console.upstash.com/qstash.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# OpenAI (obrigatório para o chat de IA embedável — /dashboard/chat-widget)
# Sem esta variável, o widget responde com uma mensagem de indisponibilidade em vez de quebrar.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Stripe Payment (required — 6 Price IDs para os 3 planos x 2 intervalos de cobrança)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_BASICO_MONTHLY_PRICE_ID="price_..."
STRIPE_BASICO_ANNUAL_PRICE_ID="price_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_ANNUAL_PRICE_ID="price_..."
STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_..."
STRIPE_BUSINESS_ANNUAL_PRICE_ID="price_..."

# Stripe Payment em USD (mercado internacional — 6 Price IDs equivalentes em dólar)
STRIPE_BASICO_MONTHLY_PRICE_ID_USD="price_..."
STRIPE_BASICO_ANNUAL_PRICE_ID_USD="price_..."
STRIPE_PRO_MONTHLY_PRICE_ID_USD="price_..."
STRIPE_PRO_ANNUAL_PRICE_ID_USD="price_..."
STRIPE_BUSINESS_MONTHLY_PRICE_ID_USD="price_..."
STRIPE_BUSINESS_ANNUAL_PRICE_ID_USD="price_..."

# Public App URL
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Uazapi (WhatsApp Integration) — chama a Uazapi direto, sem n8n/Evolution.
UAZAPI_BASE_URL=https://your-server.uazapi.com
UAZAPI_ADMIN_TOKEN=your_uazapi_admin_token
# Segredo obrigatório na query string do webhook (?secret=...) — a Uazapi não assina o payload.
UAZAPI_WEBHOOK_SECRET=your_webhook_validation_secret

# Chave para criptografar segredos em repouso (token da instância Uazapi em
# WhatsAppConfig.apiKey). 32 bytes em base64 — gerar com: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
